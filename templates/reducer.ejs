import { createSlice } from "@reduxjs/toolkit";
import type { PayloadAction } from "@reduxjs/toolkit";

export interface <%=reducerName%>State {
  value: number;
}

const initialState: <%=reducerName%>State = {
  value: 0,
};

export const <%=reducerName.toLowerCase()%>Slice = createSlice({
  name: "<%=reducerName.toLowerCase()%>",
  initialState,
  reducers: {
    increment: (state) => {
      state.value += 1;
    },
  },
});

export const { increment } = <%=reducerName.toLowerCase()%>Slice.actions;
export default <%=reducerName.toLowerCase()%>Slice.reducer;
